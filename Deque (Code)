import numpy as np
class Deque:
    def __init__(self, size):
        self.size = size                    
        self.data = np.zeros(size, dtype=np.int32) 

    def FillTheDeque(self, numbers):
        n = min(len(numbers), self.size)
        self.data[:n] = numbers[:n]  
        self.head = 0
        self.tail = n
        self.count = n
        d.Show()

    def AddToHead(self, x):
        if self.count == self.size:
            print("Дек заполнен")
            return
        
        self.head = (self.head - 1) % self.size  # отступаем назад
        self.data[self.head] = x                
        self.count += 1
        print(f"Добавлено {x} в начало")
        d.Show()
    
    def AddToTail(self, x):
        if self.count == self.size:          
            print("Дек заполнен")
            return
        
        self.data[self.tail] = x            
        self.tail = (self.tail + 1) % self.size  # сдвигаем tail вперёд
        self.count += 1                     
        print(f"Добавлено {x} в конец")
        d.Show()

    def DeleteFromTail(self, x):
        if self.count == 0:
            print("Дек пуст")
            return None
        
        self.tail = (self.tail - 1) % self.size  # отступаем назад
        x = self.data[self.tail]                  # берём значение
        self.count -= 1
        print(f"Удалён {x} из конца")
        d.Show()
        return x 

    def DeleteFromHead(self):
        if self.count == 0:
            print("Дек пуст")
            return None
        
        x = self.data[self.head]           
        self.head = (self.head + 1) % self.size  # сдвигаем вперёд
        self.count -= 1
        print(f"Удалён {x} из начала")
        d.Show()
        return x
        
    def GetByIndex(self, index):
        if index < 0 or index >= self.count:
            print("Индекс вне диапазона")
            return None
        
        real_index = (self.head + index) % self.size
        print(f"Элемент [{index}] = {self.data[real_index]}")
        return self.data[real_index]

    def Show(self):
        if self.count == 0:
            print("Дек пуст")
            return
        
        result = []
        for i in range(self.count):
            idx = (self.head + i) % self.size
            result.append(str(self.data[idx]))
        
        print("Дек: [" + ", ".join(result) + "]")

# Создаём дек
size = int(input("Размер дека: "))
d = Deque(size)

